{
  "name": "dan-mckenna-homes",
  "version": "1.0.0",
  "description": "Dan McKenna Homes website + owner editor",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "BASE_PATH=/dan-mckenna-homes PREVIEW=1 node scripts/build.mjs",
    "images": "node scripts/prepare-site-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-editor.mjs",
    "test:visual": "node tests/ui-visual.mjs && node tests/ui-visual-edge.mjs",
    "editor:demo": "node scripts/editor-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmcken19/dan-mckenna-homes.git"
  },
  "bugs": {
    "url": "https://github.com/jmcken19/dan-mckenna-homes/issues"
  },
  "homepage": "https://github.com/jmcken19/dan-mckenna-homes#readme",
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "heic2any": "^0.0.4",
    "miniflare": "^4.20260730.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "type": "module"
}
